OTL_DOMAIN=ontheline.example.org
OTL_ENVIRONMENT=production
OTL_DATABASE_PATH=/app/data/ontheline.db
OTL_AGENT_SESSION_PATH=/app/data/strands-sessions
OTL_SECRET_KEY=CHANGE_ME
OTL_HOST=0.0.0.0
OTL_PORT=8080
OTL_ALLOWED_HOSTS=ontheline.example.org
OTL_FORWARDED_ALLOW_IPS=*
OTL_HTTPS_ONLY=true
OTL_CURATOR_USERNAME=judge
OTL_CURATOR_PASSWORD=CHANGE_ME
OTL_AGENT_MODE=agentcore
OTL_AWS_REGION=us-east-1
OTL_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
OTL_AGENTCORE_RUNTIME_ARN=CHANGE_ME
OTL_PUBLIC_BASE_URL=https://ontheline.example.org
OTL_TELEPHONY_PROVIDER=twilio
OTL_TWILIO_ACCOUNT_SID=CHANGE_ME
OTL_TWILIO_AUTH_TOKEN=CHANGE_ME
OTL_TWILIO_FROM_NUMBER=CHANGE_ME
OTL_MINIMUM_CALL_INTERVAL_DAYS=1
OTL_BOOTSTRAP_SAMPLE_DATA=false
